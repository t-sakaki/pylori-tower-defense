{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "out" }
    }
  ],
  "redirects": [
    {
      "source": "/feedback/:id",
      "destination": "/api/feedback/:id",
      "permanent": true
    }
  ]
}